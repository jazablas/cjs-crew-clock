# CJ's Crew - Clock on HostGator (Apache)
Options -Indexes
DirectoryIndex index.html

<IfModule mod_rewrite.c>
RewriteEngine On
# Always use the secure address (needed for location, camera, NFC links and installing the app)
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !https
RewriteCond %{REQUEST_URI} !^/\.well-known/
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
# www.cjwtbk.com -> cjwtbk.com
RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]
# Hide repo and server-only files
RewriteCond %{REQUEST_URI} !^/\.well-known/
RewriteRule (^|/)\. - [F,L]
RewriteRule ^(README\.md|server\.py|supabase/.*)$ - [F,L]
</IfModule>

<IfModule mod_mime.c>
AddType application/manifest+json .webmanifest
AddType image/svg+xml .svg
AddType application/json .json
</IfModule>

<IfModule mod_headers.c>
Header always set Strict-Transport-Security "max-age=31536000" env=HTTPS
Header always set X-Content-Type-Options "nosniff"
Header always set Referrer-Policy "strict-origin-when-cross-origin"
Header always set X-Frame-Options "SAMEORIGIN"
Header always set Permissions-Policy "geolocation=(self), camera=(self), microphone=(), payment=(), usb=()"
# Pages, code and the service worker are checked for updates every time so changes show right away
<FilesMatch "\.(html|js|css|webmanifest)$">
  Header set Cache-Control "no-cache"
</FilesMatch>
<FilesMatch "^sw\.js$">
  Header set Cache-Control "no-cache, no-store, must-revalidate"
  Header set Service-Worker-Allowed "/"
</FilesMatch>
<FilesMatch "\.(png|svg|ico|woff2?)$">
  Header set Cache-Control "public, max-age=604800"
</FilesMatch>
</IfModule>

ErrorDocument 404 /index.html
